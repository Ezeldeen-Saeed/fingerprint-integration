{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Discovery": {
    "Enabled": true,
    "Subnets": [
      "192.168.1"
    ],
    "Port": 4370,
    "ScanOnStartup": true,
    "PeriodicScanIntervalSeconds": 3600,
    "ConnectionTimeoutSeconds": 5,
    "ParallelConnections": 100
  },
  "ZkDevice": {
    "IpAddress": "auto",
    "Port": 4370,
    "MachineNumber": 1,
    "CommPassword": null,
    "AutoDiscoverySubnet": "auto",
    "EnableAutoDiscovery": true,
    "BranchId": 1
  },
  "HrApi": {
    "BaseUrl": "https://api.firstsoft.io",
    "AttendanceEndpoint": "/api/biometric/logs",
    "CompaniesEndpoint": "/api/biometric/companies",
    "ApiKey": null,
    "AuthorizationScheme": "Bearer",
    "TimeoutSeconds": 30,
    "BatchSize": 100
  },
  "Queue": {
    "MaxRetryAttempts": 10,
    "RetryBackoffSeconds": 60,
    "DatabasePath": "queue.db"
  },
  "Sync": {
    "IntervalSeconds": 10,
    "ClearDeviceLogsAfterSync": false,
    "StateFilePath": null
  }
}
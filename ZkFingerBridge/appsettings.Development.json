{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Discovery": {
    "Enabled": true,
    "Subnets": [
      "192.168.0",
      "192.168.1",
      "192.168.100",
      "10.0.0",
      "172.16.0"
    ],
    "Port": 4370,
    "ScanOnStartup": true,
    "PeriodicScanIntervalSeconds": 3600,
    "ConnectionTimeoutSeconds": 5,
    "ParallelConnections": 100
  },
  "ZkDevice": {
    "IpAddress": "auto",
    "Port": 4370,
    "MachineNumber": 1,
    "CommPassword": null,
    "AutoDiscoverySubnet": "auto",
    "EnableAutoDiscovery": true
  },
  "HrApi": {
    "BaseUrl": "https://api.firstsoft.io",
    "AttendanceEndpoint": "/api/biometric/logs",
    "CompaniesEndpoint": "/api/biometric/companies",
    "ApiKey": null,
    "AuthorizationScheme": "Bearer",
    "TimeoutSeconds": 30,
    "BatchSize": 100
  },
  "Sync": {
    "IntervalSeconds": 10,
    "ClearDeviceLogsAfterSync": false,
    "StateFilePath": null
  }
}